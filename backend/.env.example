# Copy to .env (never commit .env). On Vercel set these in Project Settings → Environment Variables.
ENVIRONMENT=development            # development | production

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Vercel has no IPv6 egress, so do NOT use the direct db.<ref>.supabase.co host there.
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...    # used for user-facing GoTrue calls
SUPABASE_SECRET_KEY=sb_secret_...              # server only; reserved for admin operations
# Only needed if your project still signs JWTs with the legacy HS256 secret
# (Project Settings → JWT). Projects with asymmetric keys are verified via JWKS.
SUPABASE_JWT_SECRET=

GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBED_DIM=768

# Comma-separated list of allowed browser origins (Netlify site + local dev)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false                # true in production (HTTPS)

# Optional Upstash Redis (REST). Without it the app falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
